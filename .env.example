# Copy to .env and fill in. Never commit .env.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=otaku_planner
DB_PORT=3306
PORT=3001
# Required: a long random string, e.g. from `openssl rand -hex 32`. The server won't start without it.
JWT_SECRET=
# Optional: signs admin page sessions; defaults to JWT_SECRET.
SESSION_SECRET=

# Planning assistant (Google AI Studio). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to use, and how many questions each user may ask per hour.
GEMINI_MODEL=gemini-3.6-flash
ASSISTANT_HOURLY_LIMIT=30
